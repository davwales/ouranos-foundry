#!/usr/bin/env sh

# Run dotnet build to ensure the project builds successfully
dotnet build OuranosFoundry.sln --verbosity minimal

# Check the exit status of the build command
if [ $? -ne 0 ]; then
  echo "Build failed. Aborting push." >&2
  exit 1
fi

# Git LFS pre-push hook logic, only needed once .gitattributes tracks LFS files
if git grep -q "filter=lfs" -- ':(glob)**/.gitattributes'; then
    command -v git-lfs >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo >&2 "This repository tracks Git LFS files, but git-lfs was not found."
        exit 1
    fi

    git lfs pre-push "$@"
    if [ $? -ne 0 ]; then
        echo >&2 "Git LFS pre-push hook failed."
        exit 1
    fi
fi

# If build succeeds, allow the push to proceed
exit 0
