<!--
  Test project (GdUnit4Net). Suites without [RequireGodotRuntime] run in-process;
  suites with it run inside a Godot binary, so set GODOT_BIN to a Godot .NET executable.

  Core/, Features/ and Assets/ are symlinked from the repo root before evaluation so
  library sources compile into this assembly and res:// paths match the main project.
-->
<Project Sdk="Godot.NET.Sdk/4.6.3" InitialTargets="CreateSourceSymlinks">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ouranos.Foundry</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestFramework>GdUnit4</TestFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>

  <Target Name="CreateSourceSymlinks">
    <ItemGroup>
      <_SourceLink Include="Core;Features;Assets" />
    </ItemGroup>
    <Exec
      Condition="'$(OS)' == 'Windows_NT'"
      Command="if not exist &quot;$(MSBuildProjectDirectory)\%(_SourceLink.Identity)&quot; mklink /D &quot;$(MSBuildProjectDirectory)\%(_SourceLink.Identity)&quot; &quot;$(MSBuildProjectDirectory)\..\%(_SourceLink.Identity)&quot;"
      ContinueOnError="true"
    />
    <Exec
      Condition="'$(OS)' != 'Windows_NT'"
      Command="[ -L '$(MSBuildProjectDirectory)/%(_SourceLink.Identity)' ] || ln -s '../%(_SourceLink.Identity)' '$(MSBuildProjectDirectory)/%(_SourceLink.Identity)'"
      ContinueOnError="true"
    />
    <Error
      Condition="!Exists('$(MSBuildProjectDirectory)/Features')"
      Text="Failed to create source symlinks in $(MSBuildProjectDirectory). On Windows, enable Developer Mode."
    />
  </Target>
</Project>
