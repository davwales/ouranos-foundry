<?xml version="1.0" encoding="utf-8"?>
<!-- GODOT_BIN must point at a Godot 4.6 .NET executable (env var or EnvironmentVariables below). -->
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TestSessionTimeout>600000</TestSessionTimeout>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <GdUnit4>
    <DisplayName>FullyQualifiedName</DisplayName>
    <CaptureStdOut>true</CaptureStdOut>
    <!-- Run the Godot test host without a display or renderer. The suites don't render, and the
         X11/GL stack (software Mesa on CI) can make the first launch on a fresh machine slower
         than the adapter's fixed 10 s connect timeout. -->
    <Parameters>--headless</Parameters>
  </GdUnit4>
</RunSettings>
