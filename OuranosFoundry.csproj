<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Ouranos.Foundry</RootNamespace>
    <!-- Release version: <Godot version built against>.<Foundry release for that Godot version>. -->
    <Version>4.6.3.0</Version>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Godot source generators emit undocumented public members; XML docs are optional here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".gitattributes" />
    <Content Include=".gitignore" />
    <Content Include="Automation\pre-commit" />
    <Content Include="Automation\pre-push" />
    <Content Include="project.godot" />
  </ItemGroup>
</Project>
