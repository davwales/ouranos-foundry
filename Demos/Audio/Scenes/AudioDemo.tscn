[ext_resource type="AudioStream" path="res://Demos/Audio/Sounds/music_bright.wav" id="12_bright"]

[node name="AudioDemo" type="Control" node_paths=PackedStringArray("Audio", "Settings", "SoundButtons", "MusicButtons", "VolumeControls", "MuteToggle", "VoicesLabel", "MusicLabel")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")
Audio = NodePath("AudioManager")
Settings = NodePath("SettingsSaveManager")
Blip = ExtResource("7_blip")
Zap = ExtResource("8_zap")
Tracks = [ExtResource("10_calm"), ExtResource("11_tense"), ExtResource("12_bright")]
Playlist = ExtResource("9_playlist")
SoundButtons = NodePath("Layout/SoundButtons")
MusicButtons = NodePath("Layout/MusicButtons")
VolumeControls = NodePath("Layout/VolumeControls")
MuteToggle = NodePath("Layout/MuteToggle")
VoicesLabel = NodePath("Layout/VoicesLabel")
MusicLabel = NodePath("Layout/MusicLabel")

[node name="AudioManager" type="Node" parent="."]
script = ExtResource("2_manager")

[node name="Sounds" type="Node" parent="AudioManager"]
script = ExtResource("3_pool")
MaxVoices = 12

[node name="Music" type="Node" parent="AudioManager"]
script = ExtResource("4_music")

[node name="SettingsSaveManager" type="Node" parent="."]
script = ExtResource("6_save")
SaveDirectory = "user://audio_demo"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
